# Conexão com o banco local PostgreSQL
# Substitua USER, PASSWORD pelo seu usuário e senha local.
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/theburguer?schema=public"

# JWT Secret para assinar os tokens (gerar com `openssl rand -base64 64`)
JWT_SECRET=your_jwt_secret_key_here

# Stripe — Pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Print Agent Token (Autenticação do WebSocket do Print Agent)
PRINTER_AGENT_TOKEN=your_printer_agent_secret_token_here

