# Conexão com o banco local PostgreSQL
# Substitua USER, PASSWORD pelo seu usuário e senha local.
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/theburguer?schema=public"

# JWT Secret para assinar os tokens (num app real isso não vai pro git)
JWT_SECRET="theburguer_super_secret_key_2026_!@#"

# Stripe — Pagamentos
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe Webhook Secret — gerado ao configurar webhook no dashboard do Stripe
# Obtenha em: https://dashboard.stripe.com/webhooks → "Signing secret"
# Em desenvolvimento local use o Stripe CLI: stripe listen --forward-to localhost:3000/payments/webhook
STRIPE_WEBHOOK_SECRET=
